# libFuzzer dictionary for cluster data (--cluster-data): .clu, .tree and
# .ftree files, as read by ClusterMap::readClu and ClusterMap::readTree in
# src/io/ClusterMap.cpp.
# Comment and header lines the writers emit.
"# "
"# state_id module flow\x0a"
"# state_id module flow node_id layer_id\x0a"
"# path flow name node_id\x0a"
"# path flow name state_id node_id\x0a"
"# path flow name state_id node_id layer_id\x0a"
"# codelength 2 bits\x0a"
# A line starting with '*' ends a tree's node rows (an .ftree's link section).
"*Links undirected\x0a"
"*Links directed\x0a"
"*Links root 0 0 2\x0a"
"*Links 1 0.5 0.5 2\x0a"
"*"
# Tree paths, names and separators.
":"
"1:"
"1:1"
"1:1:1"
"1:2:1"
"2:1"
"0:"
":0"
"::"
"\x22"
"\x22n\x22"
"\x22a \x22b\x22 c\x22"
"\x0a"
"\x0d\x0a"
"\x09"
# Numbers at the edges of what the readers accept.
"0"
"1"
"0.5"
"1e-300"
"1e308"
"-1"
"-0"
"+1"
"nan"
"inf"
"4294967295"
"4294967296"
"18446744073709551616"
"0x10"
